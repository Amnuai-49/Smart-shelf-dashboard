 {
  "id": "io_errf",
  "type": "function",
  "z": "io_tab",
  "name": "Error text",
  "func": "// แปลง error จากโหนด s7 เป็นข้อความสำหรับแถบแดงบนหน้าจอ\nconst errorText = (msg.error && msg.error.message) || 'unknown error';\nreturn { payload: { errorText } };",
  "outputs": 1,
  "x": 330,
  "y": 240,
  "wires": [
   [
    "io_merge"
   ]
  ]
 },
 {
  "id": "io_merge",
  "type": "function",
  "z": "io_tab",
  "name": "Merge state",
  "func": "// รวมสถานะทั้งหมดเป็นก้อนเดียว เก็บใน flow context ชื่อ 'io_state'\n// เพื่อให้สลับหน้าแล้วได้สถานะครบ และใช้ตรวจสิทธิ์สั่ง Output\nconst ioState = flow.get('io_state') || {};\nconst incoming = msg.payload || {};\n['inputBits', 'outputBits', 'manual', 'running', 'fault', 'errorText', 'rawValues'].forEach(key => {\n  if (key in incoming) ioState[key] = incoming[key];\n});\nif (Array.isArray(incoming.inputBits)) ioState.errorText = '';   // ได้ข้อมูลสำเร็จ ล้าง error\n\nflow.set('io_state', ioState);\nflow.set('manual_mode_active', ioState.manual === true);         // ใช้ตรวจสิทธิ์สั่ง Output ที่โหนด Manual only\nreturn { payload: Object.assign({}, ioState) };",
  "outputs": 1,
  "x": 600,
  "y": 140,
  "wires": [
   [
    "io_tpl"
   ]
  ]
 },
