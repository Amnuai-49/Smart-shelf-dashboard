  "func": "// รับคำสั่ง CLEAR จากหน้าจอ: ล้าง Command Log ที่เก็บไว้ แล้วส่งรายการว่างกลับไปแสดง\nif (msg.topic === 'clear_command_log') {\n  flow.set('command_log', []);\n  return { payload: { commandLog: [] } };\n}\nreturn null;",
