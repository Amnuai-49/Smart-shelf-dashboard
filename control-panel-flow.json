 {
  "id": "guard1",
  "type": "function",
  "z": "cp_tab",
  "name": "Guard 0-100",
  "func": "// กันค่า Setpoint ที่ไม่ใช่จำนวนเต็มในช่วง 0-100 ไม่ให้ถึง PLC\nconst setpointValue = Number(msg.payload);\nif (!Number.isInteger(setpointValue) || setpointValue < 0 || setpointValue > 100) {\n  node.warn('Setpoint out of range: ' + msg.payload);\n  return null;\n}\nmsg.payload = setpointValue;\nreturn msg;",
