 {
  "id": "map1",
  "type": "function",
  "z": "cp_tab",
  "name": "Merge state",
  "func": "// รวมสถานะทั้งหมดเป็นก้อนเดียว เก็บใน flow context ชื่อ 'control_state'\n// เพื่อให้เปิดหน้าใหม่/สลับหน้าแล้วยังได้สถานะครบ ไม่เด้งกลับค่าเริ่มต้น\nconst controlState = flow.get('control_state') || {};\nconst incoming = msg.payload || {};\n['manual', 'running', 'fault', 'setpoint', 'goodWp', 'ngWp', 'plcConnected', 'commandLog'].forEach(key => {\n  if (key in incoming) controlState[key] = incoming[key];\n});\n\n// ---- บันทึก Command Log เฉพาะตอน tag RUN / STOP / FAULT ทำงาน ----\n// (ข้ามค่าที่อ่านได้ครั้งแรกหลังเปิดระบบ จะบันทึกเมื่อสถานะ \"เปลี่ยน\" เท่านั้น)\nconst MAX_LOG_ENTRIES = 50;\nconst newEvents = [];\n\nif (typeof incoming.running === 'boolean') {\n  const previousRunning = flow.get('previous_running');\n  if (previousRunning !== undefined && previousRunning !== incoming.running) {\n    newEvents.push(incoming.running\n      ? { label: 'RUN',  color: 'green', message: 'Machine RUN',  address: 'DB1.DBX0.3 = 1' }\n      : { label: 'STOP', color: 'red',   message: 'Machine STOP', address: 'DB1.DBX0.3 = 0' });\n  }\n  flow.set('previous_running', incoming.running);\n}\nif (typeof incoming.fault === 'boolean') {\n  const previousFault = flow.get('previous_fault');\n  if (previousFault === false && incoming.fault === true) {\n    newEvents.push({ label: 'FAULT', color: 'amber', message: 'FAULT active', address: 'DB1.DBX0.4 = 1' });\n  }\n  flow.set('previous_fault', incoming.fault);\n}\nif (newEvents.length) {\n  const now = Date.now();\n  const commandLog = flow.get('command_log') || [];\n  newEvents.forEach((event, index) => {\n    commandLog.unshift(Object.assign({ id: now + '-' + index, timestamp: now }, event));\n  });\n  if (commandLog.length > MAX_LOG_ENTRIES) commandLog.length = MAX_LOG_ENTRIES;\n  flow.set('command_log', commandLog);\n  controlState.commandLog = commandLog.slice();\n}\nif (!controlState.commandLog) controlState.commandLog = (flow.get('command_log') || []).slice();\n\nflow.set('control_state', controlState);\nreturn { payload: Object.assign({}, controlState) };",
  "outputs": 1,
  "x": 370,
  "y": 80,
  "wires": [
   [
    "tpl1",
    "mon_tpl"
   ]
  ]
 },
