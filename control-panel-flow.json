  "format": "<template><div class=\"monitoring-card\"><p class=\"card-label\">MONITORING</p><div class=\"monitoring-grid\"><div class=\"monitoring-item\"><span class=\"monitoring-label\">GOOD WP</span><strong>{{ msg && msg.payload && msg.payload.goodWp !== undefined && msg.payload.goodWp !== null ? msg.payload.goodWp : '--' }}</strong><span>DB1.DBW4 (INT)</span></div><div class=\"monitoring-item\"><span class=\"monitoring-label\">NG WP</span><strong>{{ msg && msg.payload && msg.payload.ngWp !== undefined && msg.payload.ngWp !== null ? msg.payload.ngWp : '--' }}</strong><span>DB1.DBW6 (INT)</span></div><div class=\"monitoring-item\"><span class=\"monitoring-label\">WP SET</span><strong>{{ msg && msg.payload && msg.payload.setpoint !== undefined && msg.payload.setpoint !== null ? msg.payload.setpoint : '--' }}</strong><span>DB1.DBW2 (INT)</span></div></div></div></template><style>.monitoring-card{padding:16px;color:#e5e7eb;background:#111a2b;border:1px solid #1f2a3d;border-radius:10px}.card-label{margin:0 0 14px;color:#9ca3af;font-size:12px;font-weight:600;letter-spacing:.8px}.monitoring-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.monitoring-item{min-width:0;display:flex;flex-direction:column;gap:8px;padding:14px;background:#0b1220;border:1px solid #1f2a3d;border-radius:8px}.monitoring-item span{color:#9ca3af;font-size:12px}.monitoring-item strong{color:#e5e7eb;font:600 28px/1.2 Consolas,Menlo,monospace}@media(max-width:600px){.monitoring-grid{grid-template-columns:1fr}}</style>",
